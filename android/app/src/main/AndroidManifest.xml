<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- QNN unsigned PD 激活必需:允许执行 app 私有目录原生二进制 -->
    <uses-permission android:name="android.permission.EXECUTE_PRIVATE_BINARY" />
    <!-- 读 /sdcard 模型/角色 + profiling 写 /sdcard/rvc_exp -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务:防 MIUI 冻结(QNN 长任务,冻结即失败) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 麦克风前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- M2 实时变声:麦克风采集 + 音频输出 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 常驻通知(MIUI 防杀) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 注入侧包可见性(Android 11+ 目标 App 需要能看到我们的 Provider) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="RVC App"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- LSPosed 模块识别(P0:API 101) -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="RVC 实时变声机架(集成 GlassMic 注入核心)" />
        <meta-data
            android:name="xposedminversion"
            android:value="101" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 麦克风前台服务:防 MIUI 后台静音 -->
        <service
            android:name=".MicrophoneService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- P0 调试控制:adb 开关全局接管 -->
        <receiver
            android:name=".RackCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rvc.app.action.RACK" />
            </intent-filter>
        </receiver>

        <!-- 运行态决策 Provider(注入侧查询) -->
        <provider
            android:name="io.mo.glassmic.provider.RuntimeProvider"
            android:authorities="com.rvc.app.provider.runtime"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- PCM 管道 Provider(注入侧读变声后音频) -->
        <provider
            android:name="io.mo.glassmic.provider.PcmStreamProvider"
            android:authorities="com.rvc.app.provider.pcm"
            android:exported="true"
            android:grantUriPermissions="true" />

    </application>

</manifest>
