<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- QNN unsigned PD 激活必需:允许执行 app 私有目录原生二进制 -->
    <uses-permission android:name="android.permission.EXECUTE_PRIVATE_BINARY" />
    <!-- 读 /sdcard 模型/角色 + profiling 写 /sdcard/rvc_exp -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务:防 MIUI 冻结(QNN 长任务,冻结即失败) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 麦克风前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- M2 实时变声:麦克风采集 + 音频输出 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 常驻通知(MIUI 防杀) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="RVC Mobile"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- QNN FastRPC: expose system libcdsprpc.so to app namespace (Android 12+) -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <!-- P2:Compose + Miuix 新 UI 入口(launcher) -->
        <activity
            android:name=".RvcComposeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P0.5 冒烟验证入口(adb 直接启动,不占 launcher;exported=true 供 shell 启动) -->
        <activity
            android:name=".SmokeActivity"
            android:exported="true" />

        <!-- 麦克风前台服务:防 MIUI 后台静音 -->
        <service
            android:name=".MicrophoneService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
